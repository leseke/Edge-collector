		<item>
		<title>LEGO DC 30762 Retro Video Game Batman Minifigure GWP Promo Now Sold Out in USA &#038; Canada</title>
		<link>https://www.toysnbricks.com/lego-dc-30762-retro-video-game-batman-minifigure-gwp-promo-now-sold-out-in-usa-canada/</link>
					<comments>https://www.toysnbricks.com/lego-dc-30762-retro-video-game-batman-minifigure-gwp-promo-now-sold-out-in-usa-canada/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
		<pubDate>Mon, 09 Nov 2026 07:21:00 +0000</pubDate>
				<category><![CDATA[General]]></category>
		<category><![CDATA[LEGO & LEGOLAND News]]></category>
