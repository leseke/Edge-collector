		<title>LEGO Early Pre-Black Friday 2026 GWP, Promotions &#038; Sales: November 23-26, 2026</title>
		<link>https://www.toysnbricks.com/lego-early-pre-black-friday-2026-gwp-promotions-sales-november-23-26-2026/</link>
					<comments>https://www.toysnbricks.com/lego-early-pre-black-friday-2026-gwp-promotions-sales-november-23-26-2026/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
		<pubDate>Mon, 23 Nov 2026 18:00:25 +0000</pubDate>
				<category><![CDATA[Editor's Picks]]></category>
