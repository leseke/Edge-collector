		<title>FREE LEGO Holiday Gingerbread House Make &#038; Take Event at Scheels US Stores: December 2026</title>
		<link>https://www.toysnbricks.com/free-lego-holiday-gingerbread-house-make-take-event-at-scheels-us-stores-december-2026/</link>
					<comments>https://www.toysnbricks.com/free-lego-holiday-gingerbread-house-make-take-event-at-scheels-us-stores-december-2026/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
		<pubDate>Sun, 15 Nov 2026 15:50:00 +0000</pubDate>
				<category><![CDATA[Editor's Picks]]></category>
		<category><![CDATA[General]]></category>
		<category><![CDATA[LEGO Availability]]></category>
