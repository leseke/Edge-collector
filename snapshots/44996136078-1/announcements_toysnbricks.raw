	<item>
		<title>[US] Kohl&#8217;s LEGO Black Friday Deals 2026 Now Live: Up to 40% off (Over 220 Sets to Choose From)</title>
		<link>https://www.toysnbricks.com/us-kohls-lego-black-friday-deals-2026-now-live-up-to-40-off-over-220-sets-to-choose-from/</link>
					<comments>https://www.toysnbricks.com/us-kohls-lego-black-friday-deals-2026-now-live-up-to-40-off-over-220-sets-to-choose-from/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
