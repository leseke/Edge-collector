		<item>
		<title>LEGO Insiders Weekend 2026 GWP, Points Promotions &#038; Sale Now Live: November 21-22, 2026</title>
		<link>https://www.toysnbricks.com/lego-insiders-weekend-2026-gwp-points-promotions-sale-now-live-november-21-22-2026/</link>
					<comments>https://www.toysnbricks.com/lego-insiders-weekend-2026-gwp-points-promotions-sale-now-live-november-21-22-2026/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
		<pubDate>Sat, 21 Nov 2026 05:00:24 +0000</pubDate>
				<category><![CDATA[Editor's Picks]]></category>
