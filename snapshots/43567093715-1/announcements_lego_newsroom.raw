n  c-icon  c-icon--lg  c-icon--search"></i></button><label for="search-keyword" class="c-form-item__label">Search</label></div></div><ol class="NewsRoom_categoryList__MzhdU"><li><button type="button" class="c-tag  c-btn  " style="background-color:#b30bd5">Company news</button></li><li><button type="button" class="c-tag  c-btn  " style="background-color:#7e6a1b">Financial</button></li><li><button type="button" class="c-tag  c-btn  " style="background-color:#d12622">Games</button></li><li><button type="button" class="c-tag  c-btn  " style="background-color:#5c7325">Management</button></li><li><button type="button" class="c-tag  c-btn  " style="background-color:#2a007c">Partnerships</button></li><li><button type="button" class="c-tag  c-btn  " style="background-color:#8952ba">Products</button></li><li><button type="button" class="c-tag  c-btn  " style="background-color:#cb1e93">Responsibility</button></li><li><button type="button" class="c-tag  c-btn  " style="background-color:#24796c">Sites</button></li><li><button type="button" class="c-tag  c-btn  " style="background-color:#d12622">Sustainability</button></li></ol></form><ol class="NewsRoom_selectedFiltersList__T4Mxj"><li><span class="c-tag    ">Press Releases</span></li></ol></search><div class="c-list-grid  u-margin-top-lg NewsRoom_searchResults__BF5Cx " aria-live="polite" aria-busy="false"><div class="c-list-grid__inner  o-wrapper"><ul class="c-list-grid__list  o-grid  o-grid--inset-default"><li class="c-list-grid__item  o-grid__item o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--4@bp-2"><a class="c-card c-card--article" href="/en-us/aboutus/news/2026/november/lego-star-wars-50th-anniversary-sets"><div class="c-card__img  o-ratio  o-ratio--sixteen-nine  o-ratio--fit c-card__img--cut-corner-3"><img src="https://www.lego.com/cdn/cs/aboutus/assets/blt47611b0c3fc08edb/75467_Lifestyle_Cons_02.jpg?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="LEGO Star Wars A New Hope Movie Poster" sizes="(min-width: 1600px) 1080px, (min-width: 600px) 50vw, 100vw"/></div><div class="c-card__info  u-margin-bottom-sm"><div class="o-grid  o-grid--inset-xs  o-grid--inset-md@bp-1  o-grid--between  o-grid--auto  o-grid--middle"><div class="o-grid__item"><span class="c-tag    " style="background-color:#E3599D">Star Wars</span></div><div class="o-grid__item"><time dateTime="2026-11-12T14:00:00.000Z">November 12, 2026</time></div></div></div><h2 lang="en-us" class="c-card__title">A galaxy built brick by brick: New LEGO® Star Wars™ 7-piece collection revealed for the 50th anniversary of Star Wars™</h2><div class="c-card__content c-content" lang="en-us"><p>Ahead of the 50th anniversary of Star Wars next year, the LEGO Group announces a new wave of seven exciting LEGO® Star Wars™ building sets, all available from January 1st, 2027. The seven-set collection spans artwork, vehicles, helmets and display models inspired by iconic moments from across the Star Wars saga since 1977.</p>
</div></a></li><li class="c-list-grid__item  o-grid__item o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--4@bp-2"><a class="c-card c-card--article" href="/en-us/aboutus/news/2026/november/the-lego-group-unveils-its-2026-holiday-ad"><div class="c-card__img  o-ratio  o-ratio--sixteen-nine  o-ratio--fit c-card__img--cut-corner-1"><img src="https://www.lego.com/cdn/cs/aboutus/assets/bltd6cd70a9d8e3f5e1/AID262GL7c2755b5_LEGO_Brand_Hol26_2HY26_Hero_NoPack_74s_16x9_25p_OLV_Social_Titled_WIP_20261027_hd_-_1080p_(0-00-06-08).jpg?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="HERO" sizes="(min-width: 1600px) 1080px, (min-width: 600px) 50vw, 100vw"/></div><div class="c-card__info  u-margin-bottom-sm"><div class="o-grid  o-grid--inset-xs  o-grid--inset-md@bp-1  o-grid--between  o-grid--auto  o-grid--middle"><div class="o-grid__item"><span class="c-tag    " style="background-color:#00a3da">Press Releases</span></div><div class="o-grid__item"><time dateTime="2026-11-05T09:00:00.000Z">November 5, 2026</time></div></div></div><h2 lang="en-us" class="c-card__title">The LEGO Group unveils 2026 Holiday AD – where gifts are built    with so much joy, they’re (REALLY) hard to let go of</h2><div class="c-card__content c-content" lang="en-us"><p>It’s that time of the year! The LEGO Group has just dropped its global holiday campaign advert, inviting families behind the secret doors of ‘The LEGO Holiday Workshop’, where the magic behind every LEGO® set comes to life - making them the perfect gifts this holiday season.</p>
</div></a></li><li class="c-list-grid__item  o-grid__item o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--4@bp-2"><a class="c-card c-card--article" href="/en-us/aboutus/news/2026/november/first-ever-lego-set-featuring-godzilla"><div class="c-card__img  o-ratio  o-ratio--sixteen-nine  o-ratio--fit c-card__img--cut-corner-3"><img src="https://www.lego.com/cdn/cs/aboutus/assets/blte57b418cf5d70bf0/21375_Lifestyle_Envr_03.jpg?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="21375 image" sizes="(min-width: 1600px) 1080px, (min-width: 600px) 50vw, 100vw"/></div><div class="c-card__info  u-margin-bottom-sm"><div class="o-grid  o-grid--inset-xs  o-grid--inset-md@bp-1  o-grid--between  o-grid--auto  o-grid--middle"><div class="o-grid__item"><span class="c-tag    " style="background-color:#8952ba">Products</span></div><div class="o-grid__item"><time dateTime="2026-11-03T09:39:28.000Z">November 3, 2026</time></div></div></div><h2 lang="en-us" class="c-card__title">The King of the Monsters awakens: First-ever LEGO® set featuring Godzilla from Legendary’s Monsterverse® unveiled</h2><div class="c-card__content c-content" lang="en-us"><p>Legendary’s Monsterverse Godzilla enters the LEGO Group portfolio with the LEGO® Ideas Godzilla (21375) set: a towering, 5,363-piece tribute to the King of Monsters and the largest LEGO Ideas model ever launched.</p>
</div></a></li><li class="c-list-grid__item  o-grid__item o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--4@bp-2"><a class="c-card c-card--article" href="/en-us/aboutus/news/2026/october/lego-friends-heartlake-unicorn-cafe"><div class="c-card__img  o-ratio  o-ratio--sixteen-nine  o-ratio--fit c-card__img--cut-corner-6"><img src="https://www.lego.com/cdn/cs/aboutus/assets/blt8013f059e74ce279/01_LEGO_Friends_Unicorn_Café_-_London_Pop-Up_October_2026_exterior.JPG?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="Placeholder" sizes="(min-width: 1600px) 1080px, (min-width: 600px) 50vw, 100vw"/></div><div class="c-card__info  u-margin-bottom-sm"><div class="o-grid  o-grid--inset-xs  o-grid--inset-md@bp-1  o-grid--between  o-grid--auto  o-grid--middle"><div class="o-grid__item"><span class="c-tag    " style="background-color:#8952ba">Products</span></div><div class="o-grid__item"><time dateTime="2026-10-28T15:00:00.000Z">October 28, 2026</time></div></div></div><h2 lang="en-us" class="c-card__title">LEGO® Friends reveal three new sets at magical Unicorn Café pop-up</h2><div class="c-card__content c-content" lang="en-us"><p>the LEGO Group unveiled three new LEGO® Friends sets, launching 1 January 2027. The reveal took place at the LEGO Friends Unicorn Café pop-up at Potters Fields Park, London, which is opened for fans from 29–31 October, 2026.</p>
</div></a></li><li class="c-list-grid__item  o-grid__item o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--4@bp-2"><a class="c-card c-card--article" href="/en-us/aboutus/news/2026/october/the-lego-group-teams-up-with-sesame-street-to-inspire-young-children-to-fall-in-love-with-nature"><div class="c-card__img  o-ratio  o-ratio--sixteen-nine  o-ratio--fit c-card__img--cut-corner-6"><img src="https://www.lego.com/cdn/cs/aboutus/assets/bltc42aa8ac8dcb8078/Final_BM_YT_Lego_Sponsorship_YouTube_End_Card_2026_Cookie_Count_Elmo_1.png?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="The LEGO Group and Sesame Workshop" sizes="(min-width: 1600px) 1080px, (min-width: 600px) 50vw, 100vw"/></div><div class="c-card__info  u-margin-bottom-sm"><div class="o-grid  o-grid--inset-xs  o-grid--inset-md@bp-1  o-grid--between  o-grid--auto  o-grid--middle"><div class="o-grid__item"><span class="c-tag    " style="background-color:#cb1e93">Responsibility</span></div><div class="o-grid__item"><time dateTime="2026-10-27T09:45:26.000Z">October 27, 2026</time></div></div></div><h2 lang="en-us" class="c-card__title">The LEGO Group teams up with Sesame Street to inspire young children to fall in love with nature</h2><div class="c-card__content c-content" lang="en-us"><p>The LEGO Group and Sesame Workshop, the global nonprofit behind Sesame Street, have launched three new videos, funded by the LEGO Foundation, encouraging children aged 4 to 6 to discover the natural world through play.<br>
Featuring Elmo, Cookie Monster and other Sesame Street friends, the videos introduce children to bats, butterflies and worms before inviting them to build habitats using LEGO bricks and everyday craft materials. The LEGO Group’s free activity guides and printables help families and educators extend the experience through hands-on play at home and in community settings.</p>
</div></a></li><li class="c-list-grid__item  o-grid__item o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--4@bp-2"><a class="c-card c-card--article" href="/en-us/aboutus/news/2026/october/lego-group-and-daft-punk-partnership-announcement"><div class="c-card__img  o-ratio  o-ratio--sixteen-nine  o-ratio--fit c-card__img--cut-corner-7"><img src="https://www.lego.com/cdn/cs/aboutus/assets/blt851721fa30abe2a9/The_LEGO_Group_&amp;_DAFT_PUNK_HERO_Still_3_16x9.png?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="LEGO Daft Punk Minifigures" sizes="(min-width: 1600px) 1080px, (min-width: 600px) 50vw, 100vw"/></div><div class="c-card__info  u-margin-bottom-sm"><div class="o-grid  o-grid--inset-xs  o-grid--inset-md@bp-1  o-grid--between  o-grid--auto  o-grid--middle"><div class="o-grid__item"><span class="c-tag    " style="background-color:#2a007c">Partnerships</span></div><div class="o-grid__item"><time dateTime="2026-10-22T14:00:00.000Z">October 22, 2026</time></div></div></div><h2 lang="en-us" class="c-card__title">Builders After All: The LEGO Group and DAFT PUNK™ announce partnership – blending worlds of music, culture and creative experimentation</h2><div class="c-card__content c-content" lang="en-us"><p>The LEGO Group and DAFT PUNK™ are proud to announce a new partnership that aims to inspire and remix fandoms, with the Daft Punk robots entering the LEGO universe. Spanning product, content and brand experiences, the collaboration celebrates the creativity and communities that have shaped the legacy of both brands.</p>
</div></a></li><li class="c-list-grid__item  o-grid__item o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--4@bp-2"><a class="c-card c-card--article" href="/en-us/aboutus/news/2026/october/ciao-venice-the-lego-group-floats-new-icons-set"><div class="c-card__img  o-ratio  o-ratio--sixteen-nine  o-ratio--fit c-card__img--cut-corner-8"><img src="https://www.lego.com/cdn/cs/aboutus/assets/blt0ab039699f8ba2d5/11388_Lifestyle_Cons_02.jpg?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="Product Image" sizes="(min-width: 1600px) 1080px, (min-width: 600px) 50vw, 100vw"/></div><div class="c-card__info  u-margin-bottom-sm"><div class="o-grid  o-grid--inset-xs  o-grid--inset-md@bp-1  o-grid--between  o-grid--auto  o-grid--middle"><div class="o-grid__item"><span class="c-tag    " style="background-color:#8952ba">Products</span></div><div class="o-grid__item"><time dateTime="2026-10-15T13:27:14.000Z">October 15, 2026</time></div></div></div><h2 lang="en-us" class="c-card__title">Ciao, Venice: The LEGO Group floats new Icons set </h2><div class="c-card__content c-content" lang="en-us"><p>The LEGO Group reveals the LEGO® Icons Venetian Neighbourhood (11388) set. With 5,682 pieces, this is one of the most intricate city dioramas in the LEGO Icons collection and marks the first time the LEGO Group has created a cityscape-style display model of this scale, inviting builders to capture the romance, rhythm and remarkable architecture of Venice with LEGO elements – no passport required.</p>
</div></a></li><li class="c-list-grid__item  o-grid__item o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--4@bp-2"><a class="c-card c-card--article" href="/en-us/aboutus/news/2026/october/lego-ideas-marvel-star-wars"><div class="c-card__img  o-ratio  o-ratio--sixteen-nine  o-ratio--fit c-card__img--cut-corner-1"><img src="https://www.lego.com/cdn/cs/aboutus/assets/blt53edd234b8b11de1/Cocktail_Hero_Image.png?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="LEGO Star Wars Marvel Hero Asset" sizes="(min-width: 1600px) 1080px, (min-width: 600px) 50vw, 100vw"/></div><div class="c-card__info  u-margin-bottom-sm"><div class="o-grid  o-grid--inset-xs  o-grid--inset-md@bp-1  o-grid--between  o-grid--auto  o-grid--middle"><div class="o-grid__item"><span class="c-tag    " style="background-color:#00a3da">Press Releases</span></div><div class="o-grid__item"><time dateTime="2026-10-10T22:19:39.000Z">October 10, 2026</time></div></div></div><h2 lang="en-us" class="c-card__title">The LEGO Group invites fans to mash-up STAR WARS™ and MARVEL universes for the first time ever in LEGO Ideas® challenge</h2><div class="c-card__content c-content" lang="en-us"><p>The LEGO Group announced a first-of-its-kind LEGO® Ideas challenge. For the first time ever, fans are invited to mash-up Star Wars™ and Marvel by reimagining characters, vehicles and scenes from the two universes in LEGO form.</p>
</div></a></li><li class="c-list-grid__item  o-grid__item o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--4@bp-2"><a class="c-card c-card--article" href="/en-us/aboutus/news/2026/october/lego-friends-heartlake-the-musical-trailer"><div class="c-card__img  o-ratio  o-ratio--sixteen-nine  o-ratio--fit c-card__img--cut-corner-8"><img src="https://www.lego.com/cdn/cs/aboutus/assets/blt5b96d15a9e3d58b7/Friends_HeartlakeTheMusical_2026_SPCL_Poster_Horizontal_V2.jpg?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="LEGO Friends Music Poster" sizes="(min-width: 1600px) 1080px, (min-width: 600px) 50vw, 100vw"/></div><div class="c-card__info  u-margin-bottom-sm"><div class="o-grid  o-grid--inset-xs  o-grid--inset-md@bp-1  o-grid--between  o-grid--auto  o-grid--middle"><div class="o-grid__item"><span class="c-tag    " style="background-color:#E3599D">Friends</span></div><div class="o-grid__item"><time dateTime="2026-10-09T14:00:00.000Z">October 9, 2026</time></div></div></div><h2 lang="en-us" class="c-card__title">LEGO Group released the trailer for LEGO Friends: Heartlake The Musical, its first-ever LEGO Friends-inspired live-action special YouTube</h2><div class="c-card__content c-content" lang="en-us"><p>The LEGO Group released the trailer for LEGO Friends: Heartlake The Musical, its first-ever LEGO Friends-inspired live-action special. The full special premieres on 16 October on the LEGO Group’s YouTube channel.</p>
</div></a></li></ul></div></div><div class="o-wrapper  u-type-center"><button class="c-btn  c-btn--secondary  c-btn--lg" type="button" aria-label="Load more">Load more</button></div><div class="c-list-grid  u-margin-top-lg  c-list-grid--bg-color  c-list-grid--slider  shape-straight-top-right-3" data-component="5" id="section-5" style="background-color:#ffd400" data-transparent="false"><div class="c-list-grid__header  c-header"><div class="o-wrapper  c-header__inner"><h2 class="c-header__title  u-type-lg c-header__title--start">Other LEGO Group assets</h2></div></div><div class="c-list-grid__inner  o-wrapper  c-carousel c-list-grid__inner--no-corners" role="region" aria-roledescription="carousel" aria-label="Carousel"><button class="c-carousel__arrow  c-carousel__arrow--ratio-sixteen-nine  c-carousel__arrow--gutter-inset-default  c-carousel__arrow--columns-3" data-controls="prev" disabled="" aria-label="Previous" aria-describedby="carousel-scroll-feedback"></button><button class="c-carousel__arrow  c-carousel__arrow--ratio-sixteen-nine  c-carousel__arrow--gutter-inset-default  c-carousel__arrow--columns-3" data-controls="next" aria-label="Next" aria-describedby="carousel-scroll-feedback"></button><div id="carousel-scroll-feedback" aria-live="polite" aria-atomic="true" class="sr-only"></div><ul class="c-list-grid__list  o-grid  o-grid--center  o-grid--inset-default  c-carousel__list"><li class="c-list-grid__item  c-list-grid__item--1  o-grid__item    o-grid__item--12  o-grid__item--6@bp-1  o-grid__item--3@bp-2  c-carousel__item"><a class="c-card    c-card--text" title="See all assets" href="/en-us/aboutus/lego-group/policies-and-reporting/reports#section-3"><div class="c-card__img  o-ratio  o-ratio--fit-vert  o-ratio--sixteen-nine c-card__img--cut-corner-6"><img src="https://www.lego.com/cdn/cs/aboutus/assets/blt614e4233c40d354b/2025_Hero.png?width=30&amp;quality=50&amp;crop=16:9" srcSet="" class="o-ratio__content" alt="Report thumbnail image for year 2025" sizes="(mi