		<dc:creator><![CDATA[News Reporter]]></dc:creator>
		<pubDate>Thu, 05 Nov 2026 18:07:51 +0000</pubDate>
				<category><![CDATA[Editor's Picks]]></category>
		<category><![CDATA[General]]></category>
