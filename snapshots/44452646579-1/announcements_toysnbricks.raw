	<item>
		<title>[Canada] Wal-Mart LEGO Black Friday Deals 2026 Week 1 Now Live: Up to 40% off Selected Sets (Over 30 to Choose From)</title>
		<link>https://www.toysnbricks.com/canada-wal-mart-lego-black-friday-deals-2026-week-1-now-live-up-to-40-off-selected-sets-over-30-to-choose-from/</link>
					<comments>https://www.toysnbricks.com/canada-wal-mart-lego-black-friday-deals-2026-week-1-now-live-up-to-40-off-selected-sets-over-30-to-choose-from/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
		<pubDate>Thu, 19 Nov 2026 02:09:41 +0000</pubDate>
				<category><![CDATA[Editor's Picks]]></category>
