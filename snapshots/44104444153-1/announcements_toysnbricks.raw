		<item>
		<title>LEGO Insiders Weekend Promotions Revealed: Double Points, GWP Gift with Purchases &#038; Sale (November 21-22, 2026)</title>
		<link>https://www.toysnbricks.com/lego-insiders-weekend-promotions-revealed-double-points-gwp-gift-with-purchases-sale-november-21-22-2026/</link>
					<comments>https://www.toysnbricks.com/lego-insiders-weekend-promotions-revealed-double-points-gwp-gift-with-purchases-sale-november-21-22-2026/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
		<pubDate>Mon, 16 Nov 2026 17:17:23 +0000</pubDate>
				<category><![CDATA[Editor's Picks]]></category>
		<category><![CDATA[Editor's Picks Sales]]></category>
		<category><![CDATA[General]]></category>
