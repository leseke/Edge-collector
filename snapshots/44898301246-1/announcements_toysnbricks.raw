		<item>
		<title>LEGO Store Black Friday 2026: Rewards Center Insiders Points Offer Promotion Revealed</title>
		<link>https://www.toysnbricks.com/lego-store-black-friday-2026-rewards-center-insiders-points-offer-promotion-revealed/</link>
					<comments>https://www.toysnbricks.com/lego-store-black-friday-2026-rewards-center-insiders-points-offer-promotion-revealed/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
