		<item>
		<title>LEGO Black Friday 2026 Sale, Promotions, GWP, IDEAS Godzilla Release &#038; More: November 27-29, 2026</title>
		<link>https://www.toysnbricks.com/lego-black-friday-2026-sale-promotions-gwp-ideas-godzilla-release-more-november-27-29-2026/</link>
					<comments>https://www.toysnbricks.com/lego-black-friday-2026-sale-promotions-gwp-ideas-godzilla-release-more-november-27-29-2026/#respond</comments>
		
		<dc:creator><![CDATA[Toys N Bricks]]></dc:creator>
		<pubDate>Fri, 27 Nov 2026 01:48:11 +0000</pubDate>
				<category><![CDATA[Editor's Picks]]></category>
		<category><![CDATA[Editor's Picks Sales]]></category>
		<category><![CDATA[General]]></category>
		<category><![CDATA[LEGO Sales & Deals]]></category>
