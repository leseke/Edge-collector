	<item>
		<title>[US] Macy&#8217;s LEGO Black Friday November 2026 Deals Now Live: Over 120 Sets Discounted</title>
		<link>https://www.toysnbricks.com/us-macys-lego-black-friday-november-2026-deals-now-live-over-120-sets-discounted/</link>
					<comments>https://www.toysnbricks.com/us-macys-lego-black-friday-november-2026-deals-now-live-over-120-sets-discounted/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
