	<item>
		<title>Free LEGO Store Make &#038; Take Event on November 8, 2026: Magenta Flower Candle (Canada &#038; United Kingdom UK Only)</title>
		<link>https://www.toysnbricks.com/free-lego-store-make-take-event-on-november-8-2026-magenta-flower-candle-canada-united-kingdom-uk-only/</link>
					<comments>https://www.toysnbricks.com/free-lego-store-make-take-event-on-november-8-2026-magenta-flower-candle-canada-united-kingdom-uk-only/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
		<pubDate>Mon, 02 Nov 2026 14:27:23 +0000</pubDate>
