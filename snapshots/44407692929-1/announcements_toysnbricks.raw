		<item>
		<title>Black Friday 2026 Sale Now Live for LEGOLAND USA Theme Parks: Up to 50-60% off Hotel Package, Tickets &#038; More (California, Florida &#038; New York)</title>
		<link>https://www.toysnbricks.com/black-friday-2026-sale-now-live-for-legoland-usa-theme-parks-up-to-50-60-off-hotel-package-tickets-more-california-florida-new-york/</link>
					<comments>https://www.toysnbricks.com/black-friday-2026-sale-now-live-for-legoland-usa-theme-parks-up-to-50-60-off-hotel-package-tickets-more-california-florida-new-york/#respond</comments>
		
		<dc:creator><![CDATA[Ice]]></dc:creator>
		<pubDate>Wed, 18 Nov 2026 08:03:38 +0000</pubDate>
				<category><![CDATA[Editor's Picks]]></category>
