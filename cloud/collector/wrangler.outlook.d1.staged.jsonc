{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "edge-outlook-collector",
  "main": "src/outlook-worker.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edge-outlook-history",
      "database_id": "e0ca923f-8af2-4182-9df8-c8ef05ce5000"
    }
  ],
  "vars": {
    "OUTLOOK_ROUTES_ENABLED": "false",
    "OUTLOOK_CONSENT_ENABLED": "false",
    "OUTLOOK_DIAGNOSTICS_ENABLED": "false",
    "OUTLOOK_OFFERS_ENABLED": "false",
    "OUTLOOK_INGEST_ENABLED": "false",
    "OUTLOOK_MANUAL_SYNC_ENABLED": "false",
    "OUTLOOK_SCHEDULE_ENABLED": "false"
  }
}
