{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "edge-tcg-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edge-tcg-history",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID"
    }
  ]
}
